{
  "publisher": "dennis",
  "name": "vscode-template",
  "displayName": "vscode-template",
  "type": "commonjs",
  "version": "0.0.2",
  "private": true,
  "categories": [
    "Other"
  ],
  "main": "dist/index.js",
  "engines": {
    "vscode": "^1.89.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-template.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "title": "vscode-template",
      "properties": {
        "vscode-template.message": {
          "type": "string",
          "default": "Hello World",
          "description": "The message to show in the notification"
        },
        "vscode-template.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "状态栏显示HelloWorld"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run update && tsup --env.NODE_ENV production --treeshake",
    "dev": "pnpm build -- --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "esno scripts/prepare.ts && pnpm run update",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "release": "bumpp --tag --push --commit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.23.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "18.x",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^2.31.1",
    "bumpp": "^9.4.1",
    "eslint": "^9.0.0",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "reactive-vscode": "^0.2.0-beta.9",
    "tsup": "^8.1.2",
    "typescript": "^5.5.3",
    "vscode-ext-gen": "^0.3.3"
  },
  "volta": {
    "node": "18.20.4"
  }
}
